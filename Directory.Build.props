<Project>
  <PropertyGroup>
    <KeysharpVersion Condition="'$(KeysharpVersion)' == ''">0.0.0.16</KeysharpVersion>
    <Version Condition="'$(Version)' == ''">$(KeysharpVersion)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(KeysharpVersion)</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(KeysharpVersion)</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(KeysharpVersion)</InformationalVersion>

    <!-- Normalize source paths embedded in PDBs so build-machine absolute paths
         (e.g. /home/<user>/...) don't leak into shipped binaries and stack traces -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' != 'Debug' or '$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Put all Keysharp project outputs under a shared bin folder (e.g., bin/Debug/net9.0) -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin/</BaseOutputPath>
    <!-- Keep framework-specific subfolders to avoid collisions when targeting multiple TFMs -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
    <!-- All host-specific intermediate trees remain build artifacts. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- NuGet writes project.assets.json below the intermediate root. Keep that
       root OS-specific so WSL and Windows restores can share a checkout safely. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)/obj/$(MSBuildProjectName)/windows/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)/obj/$(MSBuildProjectName)/linux/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)/obj/$(MSBuildProjectName)/osx/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!-- Every project is AnyCPU on every platform. Nothing here needs a machine type baked into the managed
       assembly: native dependencies are resolved at runtime through the RID graph in deps.json (see
       CompilerHelper.GetRidNativeDependencyPath), the x64-only DllCall register shim is guarded by a
       RuntimeInformation.ProcessArchitecture check, and scripts are Roslyn-compiled as AnyCpu so they load
       in whatever process runs them. Architecture is therefore chosen with `-r <rid>`, not -p:Platform:
       a RID-less build just takes the apphost matching the SDK doing the building. -->
  <PropertyGroup>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Keysharp' OR '$(MSBuildProjectName)' == 'Keyview'">
    <IsKeysharpShippingProject>true</IsKeysharpShippingProject>
  </PropertyGroup>

  <!-- Projects whose build output lands in a release package. Deliberately a wider set than
       IsKeysharpShippingProject (which marks the two RID-specific apphosts): Keysharp.Core is a library, so
       it must not acquire RuntimeIdentifiers, but its binaries are packaged and so its payload matters. -->
  <PropertyGroup Condition="'$(IsKeysharpShippingProject)' == 'true' OR '$(MSBuildProjectName)' == 'Keysharp.Core'">
    <IsKeysharpPackagedProject>true</IsKeysharpPackagedProject>
  </PropertyGroup>

  <!-- Release packages ship no loose .pdb, saving ~0.7 MB of payload.

       What this costs, stated accurately: script assemblies never carried debug info in the first place
       (CompilerHelper.CompileFromTree calls Emit without a pdbStream), so nothing changes for script-level
       diagnostics that a script sets itself. What DOES change is the fallback in Errors.cs, where
       CaptureStackInfo/FormatStack use StackFrame.GetFileName/GetFileLineNumber: for an error raised inside
       a Keysharp.Core built-in, Error.File and Error.Line become "" and 0 rather than a location in
       Keysharp's own C# source, and Error.Stack loses its trailing " in <file>, line N" fragments. Method
       names are unaffected. Showing script authors a path inside Keysharp's implementation was of little
       use to them, so this is close to a wash - but it is a behaviour change, not a free saving.

       Debug builds, and every test and benchmark project in any configuration, keep full symbols. -->
  <PropertyGroup Condition="'$(IsKeysharpPackagedProject)' == 'true' AND '$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsKeysharpShippingProject)' == 'true' AND $([MSBuild]::IsOSPlatform('Windows'))">
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsKeysharpShippingProject)' == 'true' AND $([MSBuild]::IsOSPlatform('Linux'))">
    <RuntimeIdentifiers>linux-x64;linux-arm64;linux-arm</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsKeysharpShippingProject)' == 'true' AND $([MSBuild]::IsOSPlatform('OSX'))">
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsKeysharpShippingProject)' == 'true' AND '$(RuntimeIdentifier)' != '' AND '$(PublishDir)' == ''">
    <PublishDir>$(MSBuildThisFileDirectory)dist/publish/$(RuntimeIdentifier)/$(MSBuildProjectName)/</PublishDir>
  </PropertyGroup>

  <Target Name="RequireRuntimeIdentifierForShippingPublish"
          BeforeTargets="Publish"
          Condition="'$(IsKeysharpShippingProject)' == 'true' AND '$(RuntimeIdentifier)' == ''">
    <Error Text="Keysharp and Keyview publish output is always RID-specific. Publish with a runtime identifier, for example: dotnet publish $(MSBuildProjectName)/$(MSBuildProjectName).csproj -c Release -r win-x64" />
  </Target>

  <Import Project="../Eto/src/Eto.Mac/build/Mac.props"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) AND ('$(MSBuildProjectName)' == 'Keysharp' OR '$(MSBuildProjectName)' == 'Keyview' OR '$(MSBuildProjectName)' == 'Keysharp.OutputTest') AND Exists('../Eto/src/Eto.Mac/build/Mac.props')" />
</Project>
