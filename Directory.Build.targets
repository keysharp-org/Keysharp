<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Keysharp' OR '$(MSBuildProjectName)' == 'Keyview'">
    <ShipsPackageProviders>true</ShipsPackageProviders>
    <ShipsScriptingComponents>true</ShipsScriptingComponents>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) AND ('$(MSBuildProjectName)' == 'Keysharp' OR '$(MSBuildProjectName)' == 'Keyview' OR '$(MSBuildProjectName)' == 'Keysharp.OutputTest')">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsKeysharpShippingProject)' == 'true'">
    <_BundledComponentProject Include="$(MSBuildThisFileDirectory)Keysharp.Components\Scripting\Compiler\Keysharp.Components.Scripting.Compiler.csproj;
                                       $(MSBuildThisFileDirectory)Keysharp.Components\Scripting\Parser\Keysharp.Components.Scripting.Parser.csproj"
                              Condition="'$(ShipsScriptingComponents)' == 'true'" />
    <_BundledComponentProject Include="$(MSBuildThisFileDirectory)Keysharp.Components\Packages\NuGet\Keysharp.Components.Packages.NuGet.csproj"
                              Condition="'$(ShipsPackageProviders)' == 'true'" />
    <!-- Build-only references make restore visit the components without adding their dependencies to the host. -->
    <ProjectReference Include="@(_BundledComponentProject)" ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed;NoBuild" />
  </ItemGroup>

  <!-- Payload collection also builds components during NoBuild publishing; inheriting NoBuild would fail with NETSDK1085. -->
  <Target Name="GetBundledComponentPayload" Condition="'@(_BundledComponentProject)' != ''">
    <MSBuild Projects="@(_BundledComponentProject)"
             Targets="GetComponentPayload"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed;NoBuild">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledComponentPayload" />
    </MSBuild>
  </Target>

  <Target Name="CopyBundledComponentsToOutput"
          AfterTargets="Build"
          DependsOnTargets="GetBundledComponentPayload"
          Condition="'@(_BundledComponentProject)' != '' AND ('$(RuntimeIdentifier)' != '' OR '$(LauncherPath)' != '')">
    <Copy SourceFiles="@(_BundledComponentPayload)"
          DestinationFiles="@(_BundledComponentPayload->'$(TargetDir)%(ComponentRelativePath)')"
          SkipUnchangedFiles="true" Condition="'$(RuntimeIdentifier)' != ''" />
    <!-- Eto has already collected the build's recorded files before this payload reaches TargetDir. -->
    <Copy SourceFiles="@(_BundledComponentPayload)"
          DestinationFiles="@(_BundledComponentPayload->'$(LauncherPath)%(ComponentRelativePath)')"
          SkipUnchangedFiles="true" Condition="'$(LauncherPath)' != ''" />
  </Target>

  <!-- IL inputs can be older than published ReadyToRun images, so copies must also compare file sizes. -->
  <Target Name="IncludeBundledComponentsInPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="GetBundledComponentPayload"
          Condition="'@(_BundledComponentProject)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_BundledComponentPayload)">
        <RelativePath>%(_BundledComponentPayload.ComponentRelativePath)</RelativePath>
        <TargetPath>%(_BundledComponentPayload.ComponentRelativePath)</TargetPath>
        <PostprocessAssembly>%(_BundledComponentPayload.PostprocessAssembly)</PostprocessAssembly>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Import Project="Keysharp.Components/Scripting/Compiler/ReadyToRun.targets" />

  <Import Project="$(ETO_ROOT)/src/Eto.Mac/build/Mac.targets"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) AND ('$(MSBuildProjectName)' == 'Keysharp' OR '$(MSBuildProjectName)' == 'Keyview' OR '$(MSBuildProjectName)' == 'Keysharp.OutputTest') AND Exists('$(ETO_ROOT)/src/Eto.Mac/build/Mac.targets')" />
</Project>
