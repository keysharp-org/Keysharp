<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Keysharp' OR '$(MSBuildProjectName)' == 'Keyview'">
    <ShipsPackageProviders>true</ShipsPackageProviders>
    <ShipsScriptingComponents>true</ShipsScriptingComponents>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) AND ('$(MSBuildProjectName)' == 'Keysharp' OR '$(MSBuildProjectName)' == 'Keyview' OR '$(MSBuildProjectName)' == 'Keysharp.OutputTest')">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <Target Name="GetBundledPackageProviderPayload"
          Condition="'$(ShipsPackageProviders)' == 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)Keysharp.Components\Packages\NuGet\Keysharp.Components.Packages.NuGet.csproj"
             Targets="GetPackageProviderPayload"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledPackageProviderPayload" />
    </MSBuild>
  </Target>

  <Target Name="GetBundledScriptingComponentPayload"
          Condition="'$(ShipsScriptingComponents)' == 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)Keysharp.Components\Scripting\Compiler\Keysharp.Components.Scripting.Compiler.csproj"
             Targets="GetScriptingComponentPayload"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledScriptingComponentPayload" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildThisFileDirectory)Keysharp.Components\Scripting\Parser\Keysharp.Components.Scripting.Parser.csproj"
             Targets="GetScriptingComponentPayload"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed">
      <Output TaskParameter="TargetOutputs" ItemName="_BundledScriptingComponentPayload" />
    </MSBuild>
  </Target>

  <Target Name="CopyBundledScriptingComponentsToRidOutput"
          AfterTargets="Build"
          DependsOnTargets="GetBundledScriptingComponentPayload"
          Condition="'$(ShipsScriptingComponents)' == 'true' AND '$(RuntimeIdentifier)' != ''">
    <Copy SourceFiles="@(_BundledScriptingComponentPayload)"
          DestinationFiles="@(_BundledScriptingComponentPayload->'$(TargetDir)%(ComponentRelativePath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeBundledScriptingComponentsInPublish"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="GetBundledScriptingComponentPayload"
          Condition="'$(ShipsScriptingComponents)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_BundledScriptingComponentPayload)">
        <RelativePath>%(_BundledScriptingComponentPayload.ComponentRelativePath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="CopyBundledPackageProvidersToRidOutput"
          AfterTargets="Build"
          DependsOnTargets="GetBundledPackageProviderPayload"
          Condition="'$(ShipsPackageProviders)' == 'true' AND '$(RuntimeIdentifier)' != ''">
    <Copy SourceFiles="@(_BundledPackageProviderPayload)"
          DestinationFiles="@(_BundledPackageProviderPayload->'$(TargetDir)%(ProviderRelativePath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeBundledPackageProvidersInPublish"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="GetBundledPackageProviderPayload"
          Condition="'$(ShipsPackageProviders)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_BundledPackageProviderPayload)">
        <RelativePath>%(_BundledPackageProviderPayload.ProviderRelativePath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Eto assembles the macOS .app bundle from the files MSBuild recorded while building, which happens before
       the two targets above drop their payload into $(TargetDir), so the bundle would ship without a compiler and
       every script it runs would fail to load. Mirror both payloads into the bundle; the publish path needs no
       equivalent because it copies the publish directory wholesale. -->
  <Target Name="CopyBundledComponentsToAppBundle"
          AfterTargets="Build"
          DependsOnTargets="GetBundledScriptingComponentPayload;GetBundledPackageProviderPayload"
          Condition="'$(LauncherPath)' != ''">
    <Copy SourceFiles="@(_BundledScriptingComponentPayload)"
          DestinationFiles="@(_BundledScriptingComponentPayload->'$(LauncherPath)%(ComponentRelativePath)')"
          SkipUnchangedFiles="true"
          Condition="'$(ShipsScriptingComponents)' == 'true'" />
    <Copy SourceFiles="@(_BundledPackageProviderPayload)"
          DestinationFiles="@(_BundledPackageProviderPayload->'$(LauncherPath)%(ProviderRelativePath)')"
          SkipUnchangedFiles="true"
          Condition="'$(ShipsPackageProviders)' == 'true'" />
  </Target>

  <Import Project="../Eto/src/Eto.Mac/build/Mac.targets"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) AND ('$(MSBuildProjectName)' == 'Keysharp' OR '$(MSBuildProjectName)' == 'Keyview' OR '$(MSBuildProjectName)' == 'Keysharp.OutputTest') AND Exists('../Eto/src/Eto.Mac/build/Mac.targets')" />
</Project>
