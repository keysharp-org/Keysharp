<!-- Written from the [DBusInterface] declarations in PortalScreenCapture.cs. Not machine-derived like the
     others: IDesktopPortalScreenshot.GetAsync<T> is a generic property helper, not a D-Bus method, so the
     reflection pass skips this pair. -->
<node>
  <interface name="org.freedesktop.portal.Screenshot">
    <method name="Screenshot">
      <arg direction="in" type="s" name="parentWindow"/>
      <arg direction="in" type="a{sv}" name="options"/>
      <arg direction="out" type="o" name="handle"/>
    </method>
  </interface>
  <interface name="org.freedesktop.portal.Request">
    <method name="Close"/>
    <signal name="Response">
      <arg type="u" name="response"/>
      <arg type="a{sv}" name="results"/>
    </signal>
  </interface>
</node>
