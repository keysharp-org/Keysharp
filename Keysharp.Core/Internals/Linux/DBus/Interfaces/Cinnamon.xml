<!-- Direct compositor access remains only for process-owned overlays. Desktop
     queries, control, capture, pointer, clipboard, and events use
     libkeysharp-desktop. -->
<node>
  <interface name="io.github.keysharp.CinnamonShell1">
    <method name="RegisterHighlightOwner">
      <arg direction="in" type="s" name="ownerKey"/>
      <arg direction="in" type="s" name="busName"/>
      <arg direction="out" type="b" name="value"/>
    </method>
    <method name="ShowImageOverlay">
      <arg direction="in" type="u" name="id"/>
      <arg direction="in" type="s" name="ownerKey"/>
      <arg direction="in" type="s" name="busName"/>
      <arg direction="in" type="i" name="x"/>
      <arg direction="in" type="i" name="y"/>
      <arg direction="in" type="i" name="width"/>
      <arg direction="in" type="i" name="height"/>
      <arg direction="in" type="ay" name="pngBytes"/>
      <arg direction="out" type="b" name="value"/>
    </method>
    <method name="MoveImageOverlay">
      <arg direction="in" type="u" name="id"/>
      <arg direction="in" type="s" name="ownerKey"/>
      <arg direction="in" type="s" name="busName"/>
      <arg direction="in" type="i" name="x"/>
      <arg direction="in" type="i" name="y"/>
      <arg direction="in" type="i" name="width"/>
      <arg direction="in" type="i" name="height"/>
      <arg direction="out" type="b" name="value"/>
    </method>
    <method name="HideImageOverlay">
      <arg direction="in" type="u" name="id"/>
      <arg direction="in" type="s" name="ownerKey"/>
      <arg direction="in" type="s" name="busName"/>
      <arg direction="out" type="b" name="value"/>
    </method>
  </interface>
</node>
