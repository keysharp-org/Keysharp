<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<TargetFramework>net10.0</TargetFramework> <!-- net10.0 required so VSCode debugger doesn't crash on exceptions -->
		<DefineConstants>$(DefineConstants);LINUX;DPI</DefineConstants>
		<LangVersion>14.0</LangVersion>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<TargetFramework>net10.0</TargetFramework>
		<DefineConstants>$(DefineConstants);OSX</DefineConstants>
		<LangVersion>14.0</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<IsPublishable>false</IsPublishable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<ApplicationIcon>..\assets\Keysharp.ico</ApplicationIcon>
		<AssemblyName>Keysharp.Core</AssemblyName>
		<SignAssembly>False</SignAssembly>
		<DelaySign>False</DelaySign>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningLevel>8</WarningLevel>
	<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<OutputPath>../bin/Debug/</OutputPath>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);DEBUG;LEGACY;WINDOWS</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);DEBUG;LEGACY;LINUX</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);DEBUG;LEGACY;OSX</DefineConstants>
		<NoWarn>$(NoWarn);1701;1702;8981;0164;8974</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<OutputPath>../bin/Release/</OutputPath>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);LEGACY;WINDOWS</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);LEGACY;LINUX</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);LEGACY;OSX</DefineConstants>
		<NoWarn>$(NoWarn);1701;1702;8981;0164;8974</NoWarn>
	</PropertyGroup>

	<ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
<!--
		<PackageReference Include="Eto.Forms" Version="2.10.2" />
-->
		<!-- This custom branch fixes a bug with image functions not working if a tray menu is created in Linux,
		as well as allows implementing the MsgBox timeout feature. Available here: https://github.com/keysharp-org/Eto/tree/MessgeBoxShowAsync  -->
		<ProjectReference Include="..\..\Eto\src\Eto\Eto.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<ProjectReference Include="..\..\Eto\src\Eto.Gtk\Eto.Gtk.csproj" />
		<PackageReference Include="Tmds.DBus" Version="0.93.0" />
		<Compile Remove="Internals\Input\MacOS\**\*.cs" />
		<Compile Remove="Internals\Input\Hooks\MacOS\**\*.cs" />
		<Compile Remove="Internals\Window\MacOS\**\*.cs" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<ProjectReference Include="..\..\Eto\src\Eto.Mac\Eto.Mac64.csproj" />
		<ProjectReference Include="..\..\Eto\lib\monomac\src\MonoMac.csproj" />
		<Compile Remove="Internals\Input\Linux\**\*.cs" />
		<Compile Remove="Internals\Mapper\Linux\**\*.cs" />
		<Compile Remove="Internals\Input\Hooks\Linux\**\*.cs" />
		<Compile Remove="Internals\Window\Linux\**\*.cs" />
	</ItemGroup>

	<ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
		<Compile Remove="Builtins\Gui\Windows\Dialogs\InputDialog.cs" />
		<Compile Remove="Internals\Input\Windows\**\*.cs" />
		<Compile Remove="Internals\Mapper\Windows\**\*.cs" />
		<Compile Remove="Internals\Os\Windows\**\*.cs" />
		<Compile Remove="Internals\Input\Hooks\Windows\**\*.cs" />
		<Compile Remove="Internals\Window\Windows\**\*.cs" />
		<Compile Remove="Internals\Window\Windows\AboutBox.Designer.cs" />
		<Compile Remove="Internals\Window\Windows\AboutBox.cs" />
		<Compile Remove="Internals\Window\Windows\KeysharpActiveX.cs" />
		<Compile Remove="Internals\UI\Windows\MainWindow.cs" />
		<Compile Remove="Internals\UI\Windows\MainWindow.Designer.cs" />
		<EmbeddedResource Remove="Builtins\Gui\Windows\Dialogs\InputDialog.resx" />
		<EmbeddedResource Remove="Internals\Window\Windows\AboutBox.resx" />
		<EmbeddedResource Remove="Internals\Window\Windows\KeysharpActiveX.resx" />
		<EmbeddedResource Remove="Internals\UI\Windows\MainWindow.resx" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Keysharp.Components\Scripting\Contracts\Keysharp.Components.Scripting.csproj" />
		<ProjectReference Include="..\Keysharp.Components\Packages\Contracts\Keysharp.Components.Packages.csproj" />
		<PackageReference Include="BitFaster.Caching" Version="2.5.4" />
		<!-- 1.6.0-pre1 is the first release carrying a win-arm64 native, which Windows on ARM needs. -->
		<PackageReference Include="PCRE.NET" Version="1.6.0-pre1" />
		<PackageReference Include="Semver" Version="3.0.0" />
		<PackageReference Include="System.Management" Version="10.0.3" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Internals\Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Internals\Properties\Resources.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
			<CustomToolNamespace>Keysharp.Internals.Properties</CustomToolNamespace>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Internals\Input\Linux\Devices\" />
	</ItemGroup>
</Project>
