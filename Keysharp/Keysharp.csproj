<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<OutputType>WinExe</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationManifest>Keysharp.manifest</ApplicationManifest>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>WinExe</OutputType>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>WinExe</OutputType>
	</PropertyGroup>

	<PropertyGroup>
		<StartupObject>Keysharp.Main.Program</StartupObject>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<ApplicationIcon>..\assets\Keysharp.ico</ApplicationIcon>
		<Authors>Matt Feemster, Descolada + legacy IronAHK developers</Authors>
		<Description>A cross-platform C# port and enhancement of the AutoHotkey program</Description>
		<Company>Keysharp</Company>
		<!-- Off: would ship a refs/ folder of ~194 reference assemblies (10.5 MB) for consumers that build a
		     Roslyn compilation from DependencyModel. Our compiler resolves framework metadata itself. -->
		<PreserveCompilationContext>false</PreserveCompilationContext>
		<SignAssembly>False</SignAssembly>
		<DelaySign>False</DelaySign>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningLevel>8</WarningLevel>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<!-- Roughly halves cold startup (and Reload) by removing first-call JIT, at roughly 2x publish size.
		     Publish-only; the JIT stays available, so runtime Roslyn compilation still works. -->
		<PublishReadyToRun>true</PublishReadyToRun>
		<PublishReadyToRunComposite>false</PublishReadyToRunComposite>
		<!-- <PublishSingleFile>true</PublishSingleFile>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract> -->
	</PropertyGroup>

	<ItemGroup>
		<PublishReadyToRunExclude Include="Microsoft.CodeAnalysis.dll" />
		<PublishReadyToRunExclude Include="Microsoft.CodeAnalysis.CSharp.dll" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<OutputPath>../bin/Debug/</OutputPath>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">DEBUG;TRACE;LEGACY;WINDOWS</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">DEBUG;TRACE;LEGACY;LINUX</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">DEBUG;TRACE;LEGACY;OSX</DefineConstants>
		<NoWarn>1701;1702;8981;0164;8974</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<OutputPath>../bin/Release/</OutputPath>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">TRACE;LEGACY;WINDOWS</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">TRACE;LEGACY;LINUX</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">TRACE;LEGACY;OSX</DefineConstants>
		<NoWarn>1701;1702;8981;0164;8974</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="license.txt" />
		<None Remove="Scripts\WindowSpy.ks" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\license.txt" Link="license.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<!-- The .app bundle icon named by Info.plist. OSX-only, or 400 KB of Mach-O ships in every package. -->
		<Content Include="..\Keyview\Icon.icns" Link="Icon.icns" Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('..\Keyview\Icon.icns')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Keysharp.manifest">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="Scripts\WindowSpy.ks">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<!-- Only the scripts Keysharp itself reaches for are here: the tray menu and main window resolve
		     Scripts\<name>.cks for WindowSpy above and AtSpi/Ax below, so without them the host loses
		     functionality. Dash.ks, Template.ks, OCR.ks and the demos are not needed for that, so they belong
		     to a Keysharp install and Keysharp.Install\payload adds them. Nothing here is precompiled either -
		     the .cks form is install payload for the same reason. -->
		<Content Include="Scripts\AtSpi.ks" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="Scripts\Ax.ks" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<None Include="..\assets\Keysharp.ico" Link="Keysharp.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Include="..\assets\Keysharp.png" Link="Keysharp.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="..\assets\Keysharp.ico" Link="Keysharp.ico" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.NET.HostModel" Version="3.1.16" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Keysharp.Core\Keysharp.Core.csproj" />
		<ProjectReference Include="..\Keysharp.Components\Scripting\Contracts\Keysharp.Components.Scripting.csproj" />
		<ProjectReference Include="..\Keysharp.Components\Packages\NuGet\Keysharp.Components.Packages.NuGet.csproj" ReferenceOutputAssembly="false" Private="false" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Builtins\Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Builtins\Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>
