<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<TargetFramework>net10.0</TargetFramework>
		<DefineConstants>$(DefineConstants);LINUX</DefineConstants>
		<LangVersion>14.0</LangVersion>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<TargetFramework>net10.0</TargetFramework>
		<DefineConstants>$(DefineConstants);OSX</DefineConstants>
		<LangVersion>14.0</LangVersion>
	</PropertyGroup>
	<PropertyGroup>
		<AssemblyName>Keysharp.Components.Scripting.Compiler</AssemblyName>
		<RootNamespace>Keysharp.Components.Scripting.Compiler</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GenerateDependencyFile>true</GenerateDependencyFile>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OutputPath>$(BaseOutputPath)$(Configuration)/$(TargetFramework)/components/scripting/compiler/</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);DEBUG;LEGACY;WINDOWS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);LEGACY;WINDOWS</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Contracts\Keysharp.Components.Scripting.csproj" Private="false" />
		<ProjectReference Include="..\Parser\Keysharp.Components.Scripting.Parser.csproj" />
		<ProjectReference Include="..\..\..\Keysharp.Core\Keysharp.Core.csproj" Private="false" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
		<None Update="component.json" CopyToOutputDirectory="Always" />
		<_ComponentPayloadName Include="Keysharp.Components.Scripting.Compiler.dll;
			Keysharp.Components.Scripting.Compiler.deps.json;
			Keysharp.Components.Scripting.Parser.dll;
			Microsoft.CodeAnalysis.dll;
			Microsoft.CodeAnalysis.CSharp.dll;
			component.json" />
	</ItemGroup>
	<Target Name="ValidateComponentPayload" AfterTargets="Build">
		<Error Condition="!Exists('$(TargetDir)%(_ComponentPayloadName.Identity)')" Text="Compiler component payload is missing %(_ComponentPayloadName.Identity)." />
	</Target>
	<Target Name="GetScriptingComponentPayload" DependsOnTargets="Build" Returns="@(_ScriptingComponentPayload)">
		<ItemGroup>
			<_ScriptingComponentPayload Include="@(_ComponentPayloadName->'$(TargetDir)%(Identity)')">
				<ComponentRelativePath>components\scripting\compiler\%(Filename)%(Extension)</ComponentRelativePath>
			</_ScriptingComponentPayload>
		</ItemGroup>
	</Target>
</Project>
