<Project DefaultTargets="StagePayload">

	<!-- What a Keysharp INSTALL carries beyond Keysharp itself: the Dash, its new-script template, the demos,
	     and the .cks form of every bundled script. None of it belongs to Keysharp.csproj - `dotnet publish` of
	     that project builds the host and its helper scripts, nothing else.

	     Run once per published tree, by each packager:
	         dotnet msbuild Keysharp.Install/payload/Keysharp.Payload.proj -p:PayloadDir=<published app dir>

	     The compile has to happen here rather than in a packager script because it needs a project system,
	     and it has to happen after the publish because the .cks must come from the host being shipped. -->

	<PropertyGroup>
		<_Repo>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</_Repo>
		<_Out>$([MSBuild]::EnsureTrailingSlash('$(PayloadDir)'))</_Out>
		<_KsHost Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(_Out)Keysharp.exe</_KsHost>
		<_KsHost Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(_Out)Keysharp</_KsHost>
		<_DashSource>$(_Out)Scripts/Dash.ks</_DashSource>
		<_DashInPlace>$(_Out)Scripts/Dash.cks</_DashInPlace>
		<_DashAsm>$(_Out)Keysharp.cks</_DashAsm>
		<_DashFallback>$(_Out)Keysharp.ks</_DashFallback>
		<!-- The kpm release whose library to ship. Pinned, so a Keysharp release states which package
		     manager it carried. Must be a release that carries Kpm.Cli.CommandRunner - v0.1.2 and earlier
		     kept the commands in the kpm executable, where the host cannot reach them. Until that tag
		     exists the download simply fails, which is not fatal: packaging warns and the install says
		     package management is unavailable. -->
		<KpmVersion Condition="'$(KpmVersion)' == ''">v0.2.0</KpmVersion>
		<KpmRepository Condition="'$(KpmRepository)' == ''">keysharp-org/KPM</KpmRepository>
		<!-- Only the archive is per-runtime; the one file taken out of it is a managed library and is the
		     same in all of them. Passed by the packager, since only it knows whether this is a cross-build. -->
		<KpmRid Condition="'$(KpmRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</KpmRid>
		<KpmRid Condition="'$(KpmRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</KpmRid>
		<KpmRid Condition="'$(KpmRid)' == ''">linux-x64</KpmRid>
		<_KpmArchive>kpm-$(KpmVersion)-$(KpmRid)-framework-dependent.zip</_KpmArchive>
		<_KpmUrl>https://github.com/$(KpmRepository)/releases/download/$(KpmVersion)/$(_KpmArchive)</_KpmUrl>
		<_KpmTemp>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'obj', 'kpm', '$(KpmRid)'))</_KpmTemp>
		<!-- Development escape hatch: point this at a local KPM checkout to build the library from it
		     instead of downloading the pinned release, e.g.
		         dotnet msbuild Keysharp.Install/payload/Keysharp.Payload.proj -p:PayloadDir=... -p:KpmSourceDir=../KPM
		     A change spanning both repos otherwise has to be tagged, released and published before this
		     side can even be run against it. With this, both sides are developed against the working tree
		     and one release is cut at the end, with the pin moved once.
		     A release build must never set it: what ships is the pinned archive, so that a Keysharp release
		     can say which kpm it carried. Note a source build's version is whatever the checkout declares,
		     which is not the tag. -->
		<_KpmProject Condition="'$(KpmSourceDir)' != ''">$([MSBuild]::NormalizePath('$(KpmSourceDir)', 'src', 'KPM.Core', 'KPM.Core.csproj'))</_KpmProject>
		<!-- No trailing separator: this is passed to `dotnet build -o "..."`, and a path ending in a
		     backslash would escape the closing quote and break the command line. -->
		<_KpmSourceOut Condition="'$(KpmSourceDir)' != ''">$([MSBuild]::NormalizePath('$(_KpmTemp)', 'source'))</_KpmSourceOut>
	</PropertyGroup>

	<Target Name="StagePayload" DependsOnTargets="CopyPayload;StageKpm;PrecompileScripts" />

	<!-- What the host's `kpm` switch runs on. The library only, never the kpm executable: the commands
	     live in KPM.Core (Kpm.Cli.CommandRunner) and the host calls them directly, so a second program on
	     PATH, under a name several other package managers already use, would buy nothing.
	     Its own dependencies are deliberately not taken from the archive. Semver and, through it,
	     Microsoft.Extensions.Primitives are already in the payload at the same assembly versions, and kpm's
	     copies are built for a different framework. Should Keysharp ever stop shipping Semver, this
	     assembly stops loading and the switch reports that rather than anything worse happening.
	     Never fatal: kpm travels with Keysharp rather than being part of it, so a failed download costs
	     the convenience and not the release. -->
	<Target Name="StageKpm" DependsOnTargets="StageKpmFromSource;StageKpmFromRelease">
		<!-- A failed download is a warning; a failed source override is an error. The download can fail for
		     reasons the person packaging does not control, and the release must survive that. An override is
		     something they asked for by name, so silence would be the wrong answer. -->
		<Warning Condition="!Exists('$(_Out)KPM.Core.dll') and '$(KpmSourceDir)' == ''"
				 Text="Package management was not bundled: $(_KpmUrl) could not be downloaded. The install is complete without it and the kpm switch will say so; kpm is also available on its own from https://github.com/$(KpmRepository)/releases." />
		<Error Condition="!Exists('$(_Out)KPM.Core.dll') and '$(KpmSourceDir)' != ''"
			   Text="KpmSourceDir=$(KpmSourceDir) built no KPM.Core.dll into $(_KpmSourceOut)." />
		<Message Importance="high" Condition="Exists('$(_Out)KPM.Core.dll') and '$(KpmSourceDir)' == ''" Text="Bundled kpm $(KpmVersion) (KPM.Core.dll)." />
		<Message Importance="high" Condition="Exists('$(_Out)KPM.Core.dll') and '$(KpmSourceDir)' != ''" Text="Bundled kpm built from source at $(KpmSourceDir) - NOT the pinned $(KpmVersion) release." />
	</Target>

	<!-- The pinned release: what every real build uses. -->
	<Target Name="StageKpmFromRelease" Condition="'$(KpmSourceDir)' == ''">
		<MakeDir Directories="$(_KpmTemp)" />
		<DownloadFile SourceUrl="$(_KpmUrl)" DestinationFolder="$(_KpmTemp)" DestinationFileName="$(_KpmArchive)"
					  SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
		<PropertyGroup>
			<_KpmDownloaded>$(_KpmTemp)$(_KpmArchive)</_KpmDownloaded>
			<_KpmAbiDir>$([MSBuild]::NormalizeDirectory('$(_KpmTemp)', 'abicheck'))</_KpmAbiDir>
		</PropertyGroup>
		<Unzip SourceFiles="$(_KpmDownloaded)" DestinationFolder="$(_Out)" Include="KPM.Core.dll"
			   OverwriteReadOnlyFiles="true" Condition="Exists('$(_KpmDownloaded)')" ContinueOnError="WarnAndContinue" />
		<!-- The archive's own Semver is unzipped only to be READ, never shipped: KPM.Core binds the copy the
		     payload already carries, and this is where that pairing is decided. So this is where a mismatch
		     must fail, as a packaging error naming both versions, not as a MissingMethodException in the
		     middle of a user's kpm command months later. -->
		<Unzip SourceFiles="$(_KpmDownloaded)" DestinationFolder="$(_KpmAbiDir)" Include="Semver.dll"
			   OverwriteReadOnlyFiles="true" Condition="Exists('$(_KpmDownloaded)')" ContinueOnError="WarnAndContinue" />
		<GetAssemblyIdentity AssemblyFiles="$(_KpmAbiDir)Semver.dll" Condition="Exists('$(_KpmAbiDir)Semver.dll')">
			<Output TaskParameter="Assemblies" ItemName="_KpmSemverIdentity" />
		</GetAssemblyIdentity>
		<GetAssemblyIdentity AssemblyFiles="$(_Out)Semver.dll" Condition="Exists('$(_Out)Semver.dll')">
			<Output TaskParameter="Assemblies" ItemName="_PayloadSemverIdentity" />
		</GetAssemblyIdentity>
		<PropertyGroup>
			<_KpmSemverVersion>@(_KpmSemverIdentity->'%(Version)')</_KpmSemverVersion>
			<_PayloadSemverVersion>@(_PayloadSemverIdentity->'%(Version)')</_PayloadSemverVersion>
		</PropertyGroup>
		<!-- Newer-than-payload cannot bind (the runtime accepts equal-or-higher, never lower); a differing
		     older version binds but may hit members that moved, so it warns rather than fails. -->
		<Error Condition="'$(_KpmSemverVersion)' != '' and '$(_PayloadSemverVersion)' != ''
						  and $([System.Version]::Parse('$(_KpmSemverVersion)').CompareTo($([System.Version]::Parse('$(_PayloadSemverVersion)')))) &gt; 0"
			   Text="kpm $(KpmVersion) was built against Semver $(_KpmSemverVersion) but the payload carries $(_PayloadSemverVersion); the bundled KPM.Core.dll would fail to load. Align the Semver reference in Keysharp.Core.csproj or pin a compatible kpm." />
		<Warning Condition="'$(_KpmSemverVersion)' != '' and '$(_PayloadSemverVersion)' != ''
							and '$(_KpmSemverVersion)' != '$(_PayloadSemverVersion)'
							and $([System.Version]::Parse('$(_KpmSemverVersion)').CompareTo($([System.Version]::Parse('$(_PayloadSemverVersion)')))) &lt; 0"
				 Text="kpm $(KpmVersion) was built against Semver $(_KpmSemverVersion); the payload carries the newer $(_PayloadSemverVersion). This binds, but members kpm uses may have changed - run `keysharp --kpm version` from the staged tree if in doubt." />
		<Warning Condition="Exists('$(_Out)KPM.Core.dll') and !Exists('$(_Out)Semver.dll')"
				 Text="KPM.Core.dll was bundled but the payload carries no Semver.dll, which it needs to load. The kpm switch will fail until the payload ships it." />
	</Target>

	<!-- The local checkout, for developing a change that spans both repos. Only KPM.Core.dll is taken, so
	     this stages exactly what the release path stages and the two cannot diverge in shape. -->
	<Target Name="StageKpmFromSource" Condition="'$(KpmSourceDir)' != ''">
		<Error Condition="!Exists('$(_KpmProject)')"
			   Text="KpmSourceDir=$(KpmSourceDir) does not look like a KPM checkout: $(_KpmProject) does not exist." />
		<Exec Command="dotnet build &quot;$(_KpmProject)&quot; -c Release -o &quot;$(_KpmSourceOut)&quot; --nologo -v:minimal" />
		<Copy SourceFiles="$([System.IO.Path]::Combine('$(_KpmSourceOut)', 'KPM.Core.dll'))" DestinationFolder="$(_Out)" OverwriteReadOnlyFiles="true" />
	</Target>

	<Target Name="CopyPayload">
		<Error Condition="'$(PayloadDir)' == ''" Text="PayloadDir is required: the published app directory to add the install payload to." />
		<Error Condition="!Exists('$(_KsHost)')" Text="No Keysharp host at $(_KsHost). Publish before staging the payload." />
		<ItemGroup>
			<!-- Shell.ks is the demos' shared #include, so it ships as source with no entry point of its own.
			     OCRSnip is absent: it #includes OCR.ks by repo-relative path and needs an engine no package has. -->
			<_Demo Include="$(_Repo)demos/Shell.ks;$(_Repo)demos/ClipboardHistory.ks;$(_Repo)demos/InputHUD.ks;$(_Repo)demos/WindowGrab.ks;$(_Repo)demos/WindowTiler.ks" />
			<!-- The Dash, and the one new-script seed shared by its "New script" button and the ShellNew
			     registrations in the MSI, the MSIX manifest and the CLI install switch. Both live here rather
			     than in Keysharp\Scripts because neither is part of Keysharp. -->
			<_InstallScript Include="$(MSBuildThisFileDirectory)Dash.ks;$(MSBuildThisFileDirectory)Template.ks" />
		</ItemGroup>
		<Copy SourceFiles="@(_InstallScript)" DestinationFolder="$(_Out)Scripts" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(_Demo)" DestinationFolder="$(_Out)Demos" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="PrecompileScripts">
		<ItemGroup>
			<!-- OCR.ks and Demos/Shell.ks are absent: pure #include libraries, no entry point. -->
			<_InPlaceScript Include="$(_Out)Scripts/WindowSpy.ks" Condition="Exists('$(_Out)Scripts/WindowSpy.ks')" />
			<_InPlaceScript Include="$(_Out)Scripts/AtSpi.ks" Condition="Exists('$(_Out)Scripts/AtSpi.ks')" />
			<_InPlaceScript Include="$(_Out)Scripts/Ax.ks" Condition="Exists('$(_Out)Scripts/Ax.ks')" />
			<_InPlaceScript Include="$(_Out)Demos/*.ks" Exclude="$(_Out)Demos/Shell.ks" />
			<_BundledScript Include="@(_InPlaceScript)" />
			<_BundledScript Include="$(_DashSource)" Condition="Exists('$(_DashSource)')" />
			<!-- Listed rather than derived-then-excluded: an Exclude spec does not match a rooted transform,
			     so the Dash silently stayed in the list whenever the path was relative. -->
			<_ExpectedCks Include="@(_InPlaceScript->'%(RootDir)%(Directory)%(Filename).cks')" />
			<_ExpectedCks Include="$(_DashAsm)" Condition="Exists('$(_DashSource)')" />
		</ItemGroup>
		<!-- Publish does not prune, so a .cks from an earlier build would pass for one this run produced. -->
		<Delete Files="@(_ExpectedCks);$(_DashInPlace);$(_DashFallback)" />
		<!-- One process for the whole batch: separate hosts cost ~5s each, this costs 13s for all of them. -->
		<Exec Condition="'@(_BundledScript)' != ''" Command="&quot;$(_KsHost)&quot; --errorstdout --compile asm @(_BundledScript->'&quot;%(FullPath)&quot;', ' ')" WorkingDirectory="$(_Out)" ContinueOnError="true" />
		<!-- The Dash is the one script whose assembly is not named after its source: a bare launch finds it
		     through the ordinary <exe-name>.cks probe, so it has to sit at the app root. Moving it keeps it in
		     the batch. Safe while the Dash needs no sidecar files - DeploySupportFiles writes those beside the
		     assembly, i.e. into Scripts, and only the .cks moves. Add a #Package or Ks.RunScript to Dash.ks
		     and it must be compiled with its own dest instead. -->
		<Move Condition="Exists('$(_DashInPlace)')" SourceFiles="$(_DashInPlace)" DestinationFiles="$(_DashAsm)" />
		<!-- Cross-architecture publish: the host could not run here, so ship the Dash source under the probed
		     name instead. Never both - the probe prefers .ks, which would cost a compile on every start. -->
		<Copy Condition="Exists('$(_DashSource)') And !Exists('$(_DashAsm)')" SourceFiles="$(_DashSource)" DestinationFiles="$(_DashFallback)" />
		<!-- Report what landed on disk: the step is non-fatal, so a failed Exec is otherwise
		     indistinguishable from success until a packager notices. Each script ships its .ks either way. -->
		<ItemGroup>
			<_MissingCks Include="@(_ExpectedCks)" Condition="!Exists('%(Identity)')" />
		</ItemGroup>
		<Message Importance="high" Condition="'@(_ExpectedCks)' != '' And '@(_MissingCks)' == ''" Text="Precompiled bundled scripts for faster startup: @(_ExpectedCks->'%(Filename)%(Extension)', ', ')" />
		<Warning Condition="'@(_MissingCks)' != ''" Text="Could not precompile @(_MissingCks->'%(Filename)%(Extension)', ', '); the launchers will compile the .ks on every start. Any host output above says why." />
	</Target>

</Project>
