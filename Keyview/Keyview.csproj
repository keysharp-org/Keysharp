<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<TargetFramework>net10.0</TargetFramework>
		<DefineConstants>$(DefineConstants);LINUX</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<TargetFramework>net10.0</TargetFramework>
		<DefineConstants>$(DefineConstants);OSX</DefineConstants>
	</PropertyGroup>

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<StartupObject>Keyview.Program</StartupObject>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<ApplicationIcon>..\assets\Keysharp.ico</ApplicationIcon>
		<Authors>Matt Feemster, Descolada</Authors>
		<Description>A viewer which shows the C# code that is generated from compiling Keysharp script code</Description>
		<Company>Keysharp</Company>
		<!-- Off for the same reason as Keysharp.csproj: nothing reads the refs/ folder it would emit. -->
		<PreserveCompilationContext>false</PreserveCompilationContext>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
		<SignAssembly>False</SignAssembly>
		<DelaySign>False</DelaySign>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningLevel>8</WarningLevel>
		<NoWin32Manifest>true</NoWin32Manifest>
	<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<!-- Emit all Debug binaries to a shared bin folder so projects can load each other's outputs -->
		<OutputPath>../bin/Debug/</OutputPath>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);DEBUG;TRACE;LEGACY;WINDOWS</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);DEBUG;TRACE;LEGACY;LINUX</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);DEBUG;TRACE;LEGACY;OSX</DefineConstants>
		<NoWarn>1701;1702;8981;0164;8974</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<!-- Emit all Release binaries to the same shared bin folder -->
		<OutputPath>../bin/Release/</OutputPath>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);TRACE;LEGACY;WINDOWS</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);TRACE;LEGACY;LINUX</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);TRACE;LEGACY;OSX</DefineConstants>
		<NoWarn>1701;1702;8981;0164;8974</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="..\assets\Keysharp.ico" Link="Keysharp.ico" />
		<!-- The .app bundle icon named by Info.plist's CFBundleIconFile; see Keysharp.csproj. -->
		<Content Include="Icon.icns" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<!-- Scintilla.NET loads Scintilla.dll/Lexilla.dll from <appbase>\runtimes\win-<arch>\native\ and never
		     from the app root, and the package's own scintilla5.net.targets already copies its whole
		     runtimes/** tree there for every Windows RID. So nothing needs copying by hand. -->
		<PackageReference Include="Scintilla5.NET" Version="6.1.1" />

		<Compile Update="Keyview.Designer.cs">
			<DependentUpon>Keyview.resx</DependentUpon>
		</Compile>
		<EmbeddedResource Update="Keyview.resx">
			<DependentUpon>Keyview.Designer.cs</DependentUpon>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
<!--
		<PackageReference Include="Eto.Forms" Version="2.10.2" />
-->
		<ProjectReference Include="..\..\Eto\src\Eto\Eto.csproj" />

		<Compile Remove="Keyview.Designer.cs" />
		<Compile Remove="HotKeyManager.cs" />
		<Compile Remove="SearchManager.cs" />
		<EmbeddedResource Remove="Keyview.resx" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
<!--
		<PackageReference Include="Eto.Platform.Gtk" Version="2.10.2" />
-->
		<ProjectReference Include="..\..\Eto\src\Eto.Gtk\Eto.Gtk.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<ProjectReference Include="..\..\Eto\src\Eto.Mac\Eto.Mac64.csproj" />
		<ProjectReference Include="..\..\Eto\lib\monomac\src\MonoMac.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Keysharp\Keysharp.csproj" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\Keysharp.Core\Keysharp.Core.csproj" />
		<ProjectReference Include="..\Keysharp.Components\Scripting\Contracts\Keysharp.Components.Scripting.csproj" />
		<ProjectReference Include="..\Keysharp.Components\Packages\NuGet\Keysharp.Components.Packages.NuGet.csproj" ReferenceOutputAssembly="false" Private="false" />
	</ItemGroup>

	<!-- Populates the Keyview.app in the *build* output with Keysharp's runtime files, purely so Keyview can be
	     run/debugged from the IDE. Shipping bundles never come from here - the packagers publish both projects
	     into dist/publish/<rid>/ (see Keysharp.Install/package-macos.sh).
	     RuntimeIdentifier is deliberately not forwarded: on macOS Directory.Build.targets gives every shipping
	     project a default RID, and passing that on as a *global* property would push the inner build into a
	     bin/<cfg>/<tfm>/<rid>/ tree of its own - a second output tree that only macOS would have. An explicitly
	     requested RID (-r) is already a global property and still reaches the inner build on its own, so both
	     builds land in the same place either way, exactly as on Windows and Linux. -->
	<Target Name="BuildAndCopyKeysharpForMac" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$(MacIsBuildingBundle)' != 'True'">
		<MSBuild Projects="..\Keysharp\Keysharp.csproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=AnyCPU;Restore=false">
			<Output TaskParameter="TargetOutputs" ItemName="_KeysharpBuiltAssembly" />
		</MSBuild>

		<PropertyGroup>
			<!-- Taken from what the build just produced rather than recomposed as bin/<cfg>/<tfm>[/<rid>]:
			     whether the RID is part of that path depends on how the build was invoked, and this target
			     has no business encoding either layout. -->
			<_KeysharpOutputDir>%(_KeysharpBuiltAssembly.RootDir)%(_KeysharpBuiltAssembly.Directory)</_KeysharpOutputDir>
			<_FinalMacBundleDir>$(TargetDir)Keyview.app/Contents/MacOS</_FinalMacBundleDir>
		</PropertyGroup>

		<ItemGroup>
			<!-- Prefer files from Keysharp.app bundle when present: its MacOS folder holds exactly Keysharp's
			     own runtime files. -->
			<_KeysharpRuntimeFiles Include="$(_KeysharpOutputDir)/Keysharp.app/Contents/MacOS/Keysharp*" />
			<_KeysharpRuntimeFiles Include="$(_KeysharpOutputDir)/Keysharp.app/Contents/MacOS/Scripts/**" />
			<!-- Fallback to the flat output folder, and only with no bundle to take files from: that folder is
			     shared with every other project in the repo, so "Keysharp*" also matches Keysharp.Tests and
			     Keysharp.Benchmark there. -->
			<_KeysharpRuntimeFiles Condition="!Exists('$(_KeysharpOutputDir)/Keysharp.app')" Include="$(_KeysharpOutputDir)/Keysharp*" />
			<_KeysharpRuntimeFiles Condition="!Exists('$(_KeysharpOutputDir)/Keysharp.app')" Include="$(_KeysharpOutputDir)/Scripts/**" />
			<_KeysharpRuntimeFiles Remove="@(_KeysharpRuntimeFiles)" Condition="'%(Extension)' == '.pdb' or '%(Extension)' == '.ico' or '%(Extension)' == '.png' or '%(Extension)' == '.manifest'" />
			<_KeysharpRuntimeFiles Remove="@(_KeysharpRuntimeFiles)" Condition="'%(Filename)' == 'Keysharp.OutputTest' or '%(Filename)' == 'Keysharp.OutputTest.deps' or '%(Filename)' == 'Keysharp.OutputTest.runtimeconfig' or '%(Filename)' == 'Keysharp.OutputTest.dll'" />
		</ItemGroup>

		<MakeDir Directories="$(_FinalMacBundleDir)" />
		<Copy SourceFiles="@(_KeysharpRuntimeFiles)" DestinationFiles="@(_KeysharpRuntimeFiles->'$(_FinalMacBundleDir)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>
</Project>
