<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<TargetFramework>net10.0</TargetFramework>
		<!--
			Auto-apply the macOS run settings so `dotnet test` excludes the Gui/Clipboard/UI categories
			(they need AppKit on OS thread 1, which the test host cannot drive). Without this, those tests
			run and fail. Note: a command-line category filter still overrides the NUnit Where clause, so the
			per-test headless guards remain the backstop for filtered runs.
		-->
		<RunSettingsFilePath>$(MSBuildProjectDirectory)/keysharp.macos.runsettings</RunSettingsFilePath>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
		<OutputType>WinExe</OutputType>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<GenerateRuntimeConfigDevFile>true</GenerateRuntimeConfigDevFile>
		<Authors>Matt Feemster</Authors>
		<Description>A suite of unit tests to verify Keysharp functionality</Description>
		<Company>Keysharp</Company>
		<!-- Off for the same reason as Keysharp.csproj. Kept in step with the shipping projects so the tests
		     exercise the same deps.json shape a release actually has. -->
		<PreserveCompilationContext>false</PreserveCompilationContext>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
		<SignAssembly>False</SignAssembly>
		<DelaySign>False</DelaySign>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningLevel>8</WarningLevel>
	<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<OutputPath>../bin/Debug/</OutputPath>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">DEBUG;LEGACY;WINDOWS</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">DEBUG;LEGACY;LINUX</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">DEBUG;LEGACY;OSX</DefineConstants>
		<NoWarn>1701;1702;8981;0164;8974</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<OutputPath>../bin/Release/</OutputPath>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">LEGACY;WINDOWS</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">LEGACY;LINUX</DefineConstants>
		<DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">LEGACY;OSX</DefineConstants>
		<NoWarn>1701;1702;8981;0164;8974</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="..\assets\Keysharp.ico" Link="Keysharp.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NUnit" Version="4.4.0" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.1.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Keysharp.Core\Keysharp.Core.csproj" />
		<ProjectReference Include="..\Keysharp.Components\Scripting\Parser\Keysharp.Components.Scripting.Parser.csproj" />
		<ProjectReference Include="..\Keysharp.Components\Scripting\Compiler\Keysharp.Components.Scripting.Compiler.csproj" />
		<ProjectReference Include="..\Keysharp.Components\Packages\NuGet\Keysharp.Components.Packages.NuGet.csproj" ReferenceOutputAssembly="false" Private="false" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Code\Gui\killbill.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="Code\Gui\monkey.ico">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="Code\Gui\Robin.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
